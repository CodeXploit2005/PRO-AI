# MongoDB Atlas Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/byethpt?retryWrites=true&w=majority"

# Auth.js / NextAuth Secret (Generate via: npx auth secret)
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional - for Google Login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Gemini API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"

# Cloudinary Upload Configuration (Or UploadThing)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Pusher Realtime Configuration (For Study Groups)
PUSHER_APP_ID="your-pusher-app-id"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"
